# محیط
ENV=development
DEBUG=True

# امنیت - حتماً تغییر دهید
ENCRYPTION_KEY=change_this_to_64_character_hex_string_please_do_it_now
JWT_SECRET=change_this_to_32_character_hex_string

# منابع
SOURCES_0_NAME=primary
SOURCES_0_URL=https://example.com/sub.txt
SOURCES_0_TYPE=v2ray
SOURCES_0_ENABLED=True
SOURCES_0_TIMEOUT=30

# خروجی
OUTPUTS_0_TYPE=txt
OUTPUTS_0_PATH=output/sub.txt

# لاگ
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_SECURITY_FILE=logs/security.log

# محدودیت‌ها
MAX_CONFIGS=600
MAX_REQUEST_SIZE=10485760

# تلگرام (اختیاری)
TELEGRAM_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# API (اختیاری)
API_ENABLED=False
API_PORT=8000
API_HOST=127.0.0.1